# Copy this file to .env and enter your own key. Never commit .env.
# PART 1. Chat model: writes the answers and chooses the tools.
LLM_API_URL=https://www.iai.nkust.edu.tw/aihub/v1/
MODEL_NAME=Furen-large
API_KEY=

# PART 2. Embedding model: turns text into vectors for the RAG search over shop_rules.txt.
# On the same server as the chat model, EMBEDDING_API_URL and EMBEDDING_API_KEY may stay empty:
# the program then uses LLM_API_URL and API_KEY.
EMBEDDING_API_URL=https://www.iai.nkust.edu.tw/aihub/v1/
EMBEDDING_MODEL_NAME=Embedding
EMBEDDING_API_KEY=
